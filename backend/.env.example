# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring.
# PAROL o'rniga PostgreSQL'ning "postgres" foydalanuvchisi parolini yozing.
DATABASE_URL="postgresql://postgres:PAROL@localhost:5432/quvnoq_sinf?schema=public"

# Tokenlarni imzolash uchun uzun tasodifiy satr (har bir server uchun alohida)
JWT_SECRET="bu-yerga-uzun-tasodifiy-satr-yozing"

PORT=3000
# Frontend manzili (vergul bilan bir nechta yozish mumkin)
CORS_ORIGIN="http://localhost:5173"

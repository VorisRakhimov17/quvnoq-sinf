// Quvnoq Sinf ma'lumotlar bazasi sxemasi
// O'zgartirgandan keyin: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// O'qituvchi akkaunti
model Teacher {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  /// AI bilan o'yin yaratish uchun kredit balansi (1 kredit = 1 o'yin)
  credits      Int          @default(0)
  createdAt    DateTime     @default(now())
  results      GameResult[]
  questions    Question[]
  creditTxs    CreditTx[]
  purchases    Purchase[]
  presentations Presentation[]
}

enum PurchaseStatus {
  pending   // yaratildi, chek kutilmoqda
  submitted // chek Telegram orqali yuborildi, admin tekshiradi
  approved  // tasdiqlandi, kredit qo'shildi
  rejected  // rad etildi
}

/// Kredit paketini sotib olish so'rovi (karta orqali to'lov + Telegram'da chek)
model Purchase {
  id         Int            @id @default(autoincrement())
  code       String         @unique // botga /start bilan yuboriladigan qisqa kod
  teacherId  Int
  teacher    Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  credits    Int
  price      Int            // so'mda
  status     PurchaseStatus @default(pending)
  tgChatId   String?        // chek yuborgan Telegram chat
  receiptId  String?        // Telegram file_id (chek rasmi)
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
  @@index([teacherId, createdAt])
}

enum CreditReason {
  welcome  // ro'yxatdan o'tganda bepul
  generate // o'yin yaratishga sarflandi
  refund   // AI xato qilgani uchun qaytarildi
  purchase // sotib olindi (admin qo'shdi)
  admin    // admin qo'lda o'zgartirdi
}

/// Kredit harakatlari tarixi: har bir qo'shish va yechish
model CreditTx {
  id        Int          @id @default(autoincrement())
  teacherId Int
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  amount    Int          // + qo'shildi, - yechildi
  reason    CreditReason
  note      String?
  createdAt DateTime     @default(now())

  @@index([teacherId, createdAt])
}

enum Subject {
  math   // Matematika
  lang   // Ona tili va o'qish
  nature // Tabiatshunoslik
}

/// Bitta o'yin raundi natijasi (10 ta savol)
model GameResult {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  gameId    String
  grade     Int
  teams     Boolean  @default(false)
  total     Int
  score     Int
  team1     Int?
  team2     Int?
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
}

/// O'qituvchi o'zi qo'shgan savol
model Question {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject
  grade     Int
  prompt    String
  emoji     String?
  options   String[]
  answer    String
  explain   String?
  /// Dars mavzusi (masalan "7 karra jadvali"); AI yaratgan savollar shu bilan guruhlanadi
  topic     String?
  createdAt DateTime @default(now())

  @@index([teacherId, subject, grade])
  @@index([teacherId, topic])
}

/// AI tayyorlagan dars prezentatsiyasi (slaydlar JSON ko'rinishida)
model Presentation {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject
  grade     Int
  topic     String
  title     String
  /// Uslub nomi (takrorlanmasligi uchun keyingi so'rovda AI ga aytiladi)
  style     String
  /// { theme, mascot, slides[] }
  deck      Json
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
}
